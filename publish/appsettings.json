{
  "Sync": {
    "IntervalMinutes": 60,
    "WorkspaceRoot": "workspace",
    "ContainerName": "codemap-source",
    "StorageServiceUri": "https://codemapstorage01.blob.core.windows.net",
    "Sources": [
      {
        "Id": "eypinn-public",
        "Name": "eypinn public GitHub repositories",
        "Type": "github",
        "Enabled": true,
        "Discovery": {
          "Owner": "eypinn",
          "OwnerType": "user",
          "IncludeRepositories": [
            "*"
          ],
          "ExcludeRepositories": [],
          "IncludeForks": false,
          "IncludeArchived": false,
          "MaxRepositories": 500
        }
      }
    ]
  },
  "SqlSources": {
    "Databases": [
      {
        "Id": "azure-sql",
        "Name": "Azure SQL Server",
        "ConnectionStringName": "SqlDatabase",
        "Enabled": true,
        "DiscoverDatabases": true,
        "IncludeDatabases": [
          "*"
        ],
        "ExcludeDatabases": [
          "master",
          "model",
          "msdb",
          "tempdb"
        ]
      }
    ]
  }
}
