  <DataSets>
    <DataSet Name="DataSet1">
      <Query>
        <DataSourceName>Knime</DataSourceName>
        <rd:DesignerState>
          <QueryDefinition xmlns="http://schemas.microsoft.com/ReportingServices/QueryDefinition/Relational">
            <AutoJoin>False</AutoJoin>
            <SelectedColumns>
              <ColumnExpression ColumnOwner="CitiesSource" ColumnName="Id" />
              <ColumnExpression ColumnOwner="CitiesSource" ColumnName="Name" />
              <ColumnExpression ColumnOwner="CitiesSource" ColumnName="CountryCode" />
              <ColumnExpression ColumnOwner="CitiesDetails" ColumnName="CityId" />
              <ColumnExpression ColumnOwner="CitiesDetails" ColumnName="Population" />
              <ColumnExpression ColumnOwner="CitiesDetails" ColumnName="AreaKm2" />
            </SelectedColumns>
            <Joins>
              <Join Type="CROSS JOIN" ColumnOwner="CitiesSource" />
              <Join Type="INNER JOIN" ColumnOwner="CitiesDetails">
                <On>
                  <From ColumnOwner="CitiesSource" ColumnName="Id" />
                  <To ColumnOwner="CitiesDetails" ColumnName="CityId" />
                </On>
              </Join>
            </Joins>
          </QueryDefinition>
        </rd:DesignerState>
        <CommandText>SELECT
  CitiesSource.Id
  ,CitiesSource.Name
  ,CitiesSource.CountryCode
  ,CitiesDetails.CityId
  ,CitiesDetails.Population
  ,CitiesDetails.AreaKm2
FROM
  CitiesSource
  INNER JOIN CitiesDetails
    ON CitiesSource.Id = CitiesDetails.CityId</CommandText>
      </Query>
      <Fields>
        <Field Name="Id">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Id</DataField>
        </Field>
        <Field Name="Name">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>Name</DataField>
        </Field>
        <Field Name="CountryCode">
          <rd:TypeName>System.String</rd:TypeName>
          <DataField>CountryCode</DataField>
        </Field>
        <Field Name="CityId">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>CityId</DataField>
        </Field>
        <Field Name="Population">
          <rd:TypeName>System.Int32</rd:TypeName>
          <DataField>Population</DataField>
        </Field>
        <Field Name="AreaKm2">
          <rd:TypeName>System.Decimal</rd:TypeName>
          <DataField>AreaKm2</DataField>
        </Field>
      </Fields>
    </DataSet>
