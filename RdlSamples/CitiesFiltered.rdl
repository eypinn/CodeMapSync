<?xml version='1.0' encoding='UTF-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2008/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">
  <AutoRefresh>0</AutoRefresh>
  <DataSources>
    <DataSource Name="AzureSql">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=tcp:YOUR-SERVER.database.windows.net,1433;Initial Catalog=YOUR-DATABASE;Encrypt=True;TrustServerCertificate=False;</ConnectString>
      </ConnectionProperties>
    </DataSource>
  </DataSources>
  <DataSets>
    <DataSet Name="dsCountries">
      <Query>
        <DataSourceName>AzureSql</DataSourceName>
        <CommandText>SELECT DISTINCT CountryCode FROM dbo.Cities WHERE CountryCode IS NOT NULL ORDER BY CountryCode;</CommandText>
      </Query>
      <Fields>
        <Field Name="CountryCode">
          <DataField>CountryCode</DataField>
        </Field>
      </Fields>
    </DataSet>
    <DataSet Name="dsCities">
      <Query>
        <DataSourceName>AzureSql</DataSourceName>
        <CommandText>SELECT Id, Name, CountryCode, Population, AreaKm2 FROM dbo.CitiesVw WHERE CountryCode = @CountryCode ORDER BY Name;</CommandText>
        <QueryParameters>
          <QueryParameter Name="@CountryCode">
            <Value>=Parameters!CountryCode.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="Id">
          <DataField>Id</DataField>
        </Field>
        <Field Name="Name">
          <DataField>Name</DataField>
        </Field>
        <Field Name="CountryCode">
          <DataField>CountryCode</DataField>
        </Field>
        <Field Name="Population">
          <DataField>Population</DataField>
        </Field>
        <Field Name="AreaKm2">
          <DataField>AreaKm2</DataField>
        </Field>
      </Fields>
    </DataSet>
  </DataSets>
  <ReportParameters>
    <ReportParameter Name="CountryCode">
      <DataType>String</DataType>
      <Prompt>Ülke kodu</Prompt>
      <ValidValues>
        <DataSetReference>
          <DataSetName>dsCountries</DataSetName>
          <ValueField>CountryCode</ValueField>
          <LabelField>CountryCode</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>
  </ReportParameters>
